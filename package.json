{
  "name": "homework",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "cross-env NODE_ENV=dev nest start --watch",
    "start:prod": "cross-env NODE_ENV=prod nest start --watch",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "docker:up": "docker compose --env-file .dev.env up -d --wait",
    "docker:down": "docker compose --env-file .dev.env down",
    "migrate": "tsx --env-file=.dev.env src/database/migrate.ts latest",
    "migrate:gen": "kysely migrate make",
    "migrate:up": "tsx --env-file=.dev.env src/database/migrate.ts up",
    "migrate:down": "tsx --env-file=.dev.env src/database/migrate.ts down"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "kysely": "^0.29.7",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.22.0",
    "nestjs-kysely": "^3.1.4",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.20",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
